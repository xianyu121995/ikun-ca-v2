# Copy to .env.local. Relative DATA_ROOT is resolved from THIS worktree.
IKUN_ENV=development
DATA_ROOT=./var/dev
WEBSITE_HOST=127.0.0.1
WEBSITE_PORT=3100
HUNTER_PORT=3111
TRACKING_PORT=3112
HUNTER_API_URL=http://127.0.0.1:3111
TRACKING_API_URL=http://127.0.0.1:3112
# Required only for authenticated internal APIs; fill locally, never in chat.
HUNTER_API_TOKEN=
TRACKING_API_TOKEN=
PROJECTS_INGEST_HUNTER_TOKEN=
PROJECTS_INGEST_TRACKING_TOKEN=
# No provider keys and no external I/O in the foundation phase.
