# Values for this worktree's ignored .env.local; no credentials are stored here.
IKUN_AUTH_DEV=1
IKUN_AUTH_ORIGIN=http://127.0.0.1:3600
IKUN_AUTH_TENANT_ID=ikun-main
# The standard launcher resolves this worktree's DATA_ROOT to an absolute path.
# Production: remove IKUN_AUTH_DEV, set HTTPS origin, retain the SAME tenant ID.
