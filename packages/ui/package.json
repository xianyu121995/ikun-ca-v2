{
  "name": "@ikun/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-styles.mjs",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "test": "TSX_TSCONFIG_PATH=./tsconfig.check.json node --import tsx --test tests/*.test.tsx",
    "preview": "node scripts/preview.mjs",
    "preview:no-js": "node scripts/no-js-fixture.mjs",
    "test:no-js": "node --test tests/no-js-form.test.mjs",
    "preview:review": "node scripts/review-preview.mjs"
  },
  "peerDependencies": { "react": "^19.3.1", "react-dom": "^19.3.1" },
  "devDependencies": {
    "react": "19.3.1", "react-dom": "19.3.1",
    "@types/react": "19.3.0", "@types/react-dom": "19.3.0",
    "@types/node": "24.19.2", "typescript": "5.9.3", "tsx": "4.23.15", "esbuild": "0.28.2"
  }
}
