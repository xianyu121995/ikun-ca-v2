# 复制到服务器 /etc/ikun-hackathon.env 后 chmod 600。不要把真实环境提交到 Git。
# 这个服务不需要平台密钥。留空即可。
HACKATHON_DB=/var/lib/ikun-hackathon/hackathon.sqlite3
HACKATHON_SNAPSHOT=/var/lib/ikun-hackathon/snapshot.json
HACKATHON_POLL_SECONDS=1800
# 网站进程只读快照，不读 sqlite：
# IKUN_HACKATHON_SNAPSHOT=/var/lib/ikun-hackathon/snapshot.json
