# Copy to .env, fill locally. Never paste keys into chat.
HUNTER_DB=./var/hunter.db
HUNTER_HOST=127.0.0.1
HUNTER_PORT=8766
# Empty service tokens allow ONLY local CLI/browser access. Required for gateway/non-loopback.
HUNTER_ADMIN_TOKEN=
HUNTER_VIEW_TOKEN=
# Formal v2 website -> Hunter direction credential; minimum 32 characters, distinct from providers/receiver.
HUNTER_API_TOKEN=
OPENNEWS_TOKEN=
TWITTERAPI_IO_API_KEY=
# Optional secret file for Hunter service/provider/receiver credentials. Never reads old service .env.
HUNTER_SECRETS_FILE=
HUNTER_6551_DAILY_POINTS=1000
HUNTER_TWITTERAPI_DAILY_CREDITS=10000
HUNTER_REQUESTS_PER_MINUTE=30
HUNTER_REST_CONCURRENCY=2
# Fixed controlled receiver; empty disables delivery while confirmed jobs remain durable.
HUNTER_PROJECT_TASK_URL=
HUNTER_PROJECT_TASK_HOSTS=127.0.0.1,localhost
HUNTER_PROJECT_TASK_SECRET=

# Explicit opt-in, off even when credentials are configured.
HUNTER_EXTERNAL_IO_ENABLED=0
HUNTER_V2_MODE=0
HUNTER_TENANT_ID=ikun-main
HUNTER_DELIVERY_PROTOCOL=v2-event
PROJECTS_INGEST_HUNTER_TOKEN=
# Separate controlled Projects delivery from paid provider IO. Both disabled by default.
HUNTER_PROJECT_DELIVERY_ENABLED=0

# Night release: compiled entry rejects external collection; internal receipt delivery is independent.
HUNTER_REQUIRE_EXTERNAL_IO_DISABLED=1
