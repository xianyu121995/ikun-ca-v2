# Copy to .env, fill locally. Never paste keys into chat.
HUNTER_DB=./var/hunter.db
HUNTER_HOST=127.0.0.1
HUNTER_PORT=8766
# Empty service tokens allow ONLY local CLI/browser access. Required for gateway/non-loopback.
HUNTER_ADMIN_TOKEN=
HUNTER_VIEW_TOKEN=
OPENNEWS_TOKEN=
TWITTERAPI_IO_API_KEY=
# Optional secret file; only the four token variables above are read. Never reads old .env automatically.
HUNTER_SECRETS_FILE=
HUNTER_6551_DAILY_POINTS=1000
HUNTER_TWITTERAPI_DAILY_CREDITS=10000
HUNTER_REQUESTS_PER_MINUTE=30
HUNTER_REST_CONCURRENCY=2
# Fixed controlled receiver; empty disables delivery while confirmed jobs remain durable.
HUNTER_PROJECT_TASK_URL=
HUNTER_PROJECT_TASK_HOSTS=127.0.0.1,localhost
HUNTER_PROJECT_TASK_SECRET=

# Explicit opt-in, off even when credentials are configured.
HUNTER_EXTERNAL_IO_ENABLED=0
HUNTER_V2_MODE=0
HUNTER_TENANT_ID=
