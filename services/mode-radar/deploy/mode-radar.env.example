# 复制到服务器的 /etc/mode-radar.env 后 chmod 600。不要把真实值提交到 Git。
# 没有 WSS 就留空。不要填 http(s) RPC，不要填 127.0.0.1:8545。
RADAR_WSS_BSC=
RADAR_BRIDGE_HOST=127.0.0.1
RADAR_BRIDGE_PORT=3921
RADAR_BRIDGE_TOKEN=replace-with-32-plus-random-characters
# 网站进程用同值：IKUN_RADAR_TOKEN 与 IKUN_RADAR_ORIGIN=http://127.0.0.1:3921
# 外部 webhook / Telegram 默认关闭。不要为了通知去开公网未认证回调。
# RADAR_ALLOW_EXTERNAL_NOTIFY=1
# RADAR_WEBHOOK=
# RADAR_TG_TOKEN=
# RADAR_TG_CHAT=
# RADAR_GITHUB_TOKEN=
